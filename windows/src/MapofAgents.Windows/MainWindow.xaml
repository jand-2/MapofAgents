                                                        Click="ToggleReaderTranscriptCategoryMenuItem_Click">
                                                        <ToggleMenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE90F;" />
                                                        </ToggleMenuFlyoutItem.Icon>
                                                    </ToggleMenuFlyoutItem>
                                                    <ToggleMenuFlyoutItem
                                                        Tag="artifacts"
                                                        Text="{Binding ArtifactFilterMenuText}"
                                                        IsChecked="{Binding IsArtifactFilterActive, Mode=OneWay}"
                                                        Click="ToggleReaderTranscriptCategoryMenuItem_Click">
                                                        <ToggleMenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE7C3;" />
                                                        </ToggleMenuFlyoutItem.Icon>
                                                    </ToggleMenuFlyoutItem>
