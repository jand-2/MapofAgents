                                                            <FontIcon Glyph="&#xE946;" />
                                                        </ToggleMenuFlyoutItem.Icon>
                                                    </ToggleMenuFlyoutItem>
                                                </MenuFlyout>
	                                            </Button.Flyout>
	                                            <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="{Binding FilterButtonContentSpacing}">
