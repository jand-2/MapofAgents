                                        BorderThickness="0"
                                        ToolTipService.ToolTip="Dismiss">
                                        <FontIcon Glyph="&#xE711;" FontSize="{Binding CardDismissIconFontSize}" Foreground="#A7B0BF" />
                                    </Button>
                                </Grid>
                            </Border>
