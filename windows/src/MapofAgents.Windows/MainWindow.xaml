	                                                        Background="{Binding AttachmentToolbarButtonBackgroundBrush}"
	                                                        BorderThickness="{Binding AttachmentToolbarButtonBorderThickness}"
	                                                        Foreground="{Binding AttachmentToolbarForegroundBrush}">
	                                                        <FontIcon
