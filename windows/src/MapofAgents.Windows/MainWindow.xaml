                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
	                                        <Button
	                                            x:Name="ReaderTranscriptFilterButton"
	                                            Click="ReaderTranscriptFilterButton_Click"
	                                            Padding="{Binding FilterButtonPadding}"
