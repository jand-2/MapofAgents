<Window
    x:Class="MapofAgents.WindowsApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid
        x:Name="RootGrid"
        Background="#1D1E20"
        RequestedTheme="Dark">
        <Grid.Resources>
            <AcrylicBrush
                x:Key="MapFloatingMaterialBrush"
                TintColor="#FF212225"
                TintOpacity="0.70"
                TintLuminosityOpacity="0.46"
                FallbackColor="#D1212225" />
            <AcrylicBrush
                x:Key="MapRegularMaterialBrush"
                TintColor="#FF212225"
                TintOpacity="0.80"
                TintLuminosityOpacity="0.50"
                FallbackColor="#EA212225" />
            <ThemeShadow x:Key="RailPanelShadow" />
            <Style x:Key="ToolbarPlainButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="7,3" />
                <Setter Property="Background" Value="#00FFFFFF" />
                <Setter Property="BorderBrush" Value="#00FFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Foreground" Value="#D7DCE5" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="ToolbarPlainSplitButtonStyle" TargetType="controls:SplitButton">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="7,3" />
                <Setter Property="Background" Value="#00FFFFFF" />
                <Setter Property="BorderBrush" Value="#00FFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Foreground" Value="#D7DCE5" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="9,3" />
                <Setter Property="Background" Value="#10FFFFFF" />
                <Setter Property="BorderBrush" Value="#24FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Foreground" Value="#F2F4F7" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="ToolbarSplitButtonStyle" TargetType="controls:SplitButton">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="9,3" />
                <Setter Property="Background" Value="#10FFFFFF" />
                <Setter Property="BorderBrush" Value="#24FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Foreground" Value="#F2F4F7" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style
                x:Key="ToolbarPrimaryButtonStyle"
                TargetType="Button"
                BasedOn="{StaticResource ToolbarButtonStyle}">
                <Setter Property="Background" Value="#E60A84FF" />
                <Setter Property="BorderBrush" Value="#FF0A84FF" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Style>
            <Style
                x:Key="ToolbarPurpleButtonStyle"
                TargetType="Button"
                BasedOn="{StaticResource ToolbarButtonStyle}">
                <Setter Property="Background" Value="#24BF5AF2" />
                <Setter Property="BorderBrush" Value="#70BF5AF2" />
                <Setter Property="Foreground" Value="#FFDDB8FF" />
            </Style>
            <Style x:Key="RailListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="#00FFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>

        <controls:WebView2
            x:Name="GraphView"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <Border
            x:Name="WindowChromeBackdrop"
            Height="44"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="#001D1E20"
            IsHitTestVisible="False" />

        <Border
            x:Name="WindowChromeHairline"
            Height="1"
            Margin="0,43,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="#00FFFFFF"
            IsHitTestVisible="False" />

        <Border
            x:Name="TitleBarDragRegion"
            Height="36"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="#00FFFFFF" />

        <Border
            x:Name="CommandBarSurface"
            Margin="14"
            Padding="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            MaxWidth="1240"
            Background="{StaticResource MapRegularMaterialBrush}"
            BorderBrush="#00FFFFFF"
            BorderThickness="0"
            CornerRadius="8">
            <StackPanel
                x:Name="CommandBarLayoutRoot"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    x:Name="WorkflowButton"
                    Click="WorkflowButton_Click"
                    Style="{StaticResource ToolbarPlainButtonStyle}"
                    ToolTipService.ToolTip="Workflow">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Canvas
                            x:Name="WorkflowIcon"
                            Width="17"
                            Height="15"
                            VerticalAlignment="Center">
                            <Rectangle
                                x:Name="WorkflowTopLeftRect"
                                Canvas.Left="1"
                                Canvas.Top="1"
                                Width="7"
                                Height="6"
                                RadiusX="2"
                                RadiusY="2"
                                Fill="#00FFFFFF"
                                Stroke="#D7DCE5"
                                StrokeThickness="1" />
                            <Rectangle
                                x:Name="WorkflowBottomLeftRect"
                                Canvas.Left="1"
                                Canvas.Top="8"
                                Width="7"
                                Height="6"
                                RadiusX="2"
                                RadiusY="2"
                                Fill="#00FFFFFF"
                                Stroke="#D7DCE5"
                                StrokeThickness="1" />
                            <Rectangle
                                x:Name="WorkflowRightRect"
                                Canvas.Left="10"
                                Canvas.Top="2"
                                Width="6"
                                Height="12"
                                RadiusX="2"
                                RadiusY="2"
                                Fill="#00FFFFFF"
                                Stroke="#D7DCE5"
                                StrokeThickness="1" />
                        </Canvas>
                        <TextBlock
                            x:Name="WorkflowNameText"
                            MaxWidth="180"
                            Text="Workflow"
                            TextTrimming="CharacterEllipsis" />
                        <Canvas
                            x:Name="WorkflowChevronIcon"
                            Width="8"
                            Height="7"
                            VerticalAlignment="Center">
                            <Path
                                x:Name="WorkflowChevronPath"
                                Data="M 1.2 2.2 L 4 4.8 L 6.8 2.2"
                                Fill="#00FFFFFF"
                                Stroke="#D7DCE5"
                                StrokeThickness="1.15"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                        </Canvas>
                    </StackPanel>
                </Button>

                <Rectangle x:Name="CommandBarWorkflowDivider" Width="1" Height="20" Fill="#24FFFFFF" />

                <Button
                    x:Name="AddFolderButton"
                    AutomationProperties.Name="Add folder"
                    Click="AddFolderButton_Click"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="Add a folder to the workflow">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Canvas
                            x:Name="AddFolderIcon"
                            Width="18"
                            Height="16"
                            VerticalAlignment="Center">
                            <Path
                                x:Name="AddFolderOutlinePath"
                                Data="M 1.5 5.6 C 1.5 4.8 2.1 4.2 2.9 4.2 L 6.1 4.2 C 6.8 4.2 7.2 4.5 7.7 5.1 L 8.3 5.9 L 14.4 5.9 C 15.2 5.9 15.8 6.5 15.8 7.3 L 15.8 12.4 C 15.8 13.2 15.2 13.8 14.4 13.8 L 2.9 13.8 C 2.1 13.8 1.5 13.2 1.5 12.4 Z"
                                Fill="#00FFFFFF"
                                Stroke="#D7DCE5"
                                StrokeThickness="1.15"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                            <Ellipse
                                x:Name="AddFolderBadgeCircle"
                                Canvas.Left="12"
                                Canvas.Top="1"
                                Width="5.8"
                                Height="5.8"
                                Fill="#D7DCE5" />
                            <Line
                                x:Name="AddFolderBadgePlusHorizontalLine"
                                X1="13.4"
                                Y1="3.9"
                                X2="16.6"
                                Y2="3.9"
                                Stroke="#1D1E20"
                                StrokeThickness="1.15"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                            <Line
                                x:Name="AddFolderBadgePlusVerticalLine"
                                X1="15"
                                Y1="2.3"
                                X2="15"
                                Y2="5.5"
                                Stroke="#1D1E20"
                                StrokeThickness="1.15"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                        </Canvas>
                        <TextBlock Text="Folder" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="AddThreadButton"
                    AutomationProperties.AutomationId="AddThreadButton"
                    AutomationProperties.Name="Create Codex thread"
                    Click="AddThreadButton_Click"
                    Style="{StaticResource ToolbarPrimaryButtonStyle}"
                    ToolTipService.ToolTip="Create Codex thread">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Canvas
                            x:Name="AddThreadIcon"
                            Width="18"
                            Height="16"
                            VerticalAlignment="Center">
                            <Path
                                x:Name="AddThreadBubblePath"
                                Data="M 8.7 2.2 C 5 2.2 2.5 4.4 2.5 7.2 C 2.5 9 3.5 10.6 5.2 11.5 L 5 14 L 7.6 12.4 C 8 12.5 8.4 12.5 8.7 12.5 C 12.4 12.5 15 10.3 15 7.2 C 15 4.4 12.4 2.2 8.7 2.2 Z"
                                Fill="#00FFFFFF"
                                Stroke="#FFFFFFFF"
                                StrokeThickness="1.25"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                            <Line
                                x:Name="AddThreadPlusHorizontalLine"
                                X1="6.6"
                                Y1="7.1"
                                X2="10.8"
                                Y2="7.1"
                                Stroke="#FFFFFFFF"
                                StrokeThickness="1.15"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                            <Line
                                x:Name="AddThreadPlusVerticalLine"
                                X1="8.7"
                                Y1="5"
                                X2="8.7"
                                Y2="9.2"
                                Stroke="#FFFFFFFF"
                                StrokeThickness="1.15"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                        </Canvas>
                        <TextBlock Text="Thread" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="ReadingModeButton"
                    AutomationProperties.AutomationId="ReadingModeButton"
                    AutomationProperties.Name="Reader"
                    Click="ReadingModeButton_Click"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="Open focused chat reading mode">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Grid
                            x:Name="ReadingModeIcon"
                            Width="15"
                            Height="14"
                            VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="ReadingModeLeftPane"
                                Grid.Column="0"
                                Margin="0,1,1,1"
                                BorderBrush="#D7DCE5"
                                BorderThickness="1"
                                CornerRadius="2,0,0,2" />
                            <Border
                                x:Name="ReadingModeMiddlePane"
                                Grid.Column="1"
                                Margin="0,1"
                                BorderBrush="#D7DCE5"
                                BorderThickness="1,1,0,1" />
                            <Border
                                x:Name="ReadingModeRightPane"
                                Grid.Column="2"
                                Margin="0,1,0,1"
                                BorderBrush="#D7DCE5"
                                BorderThickness="1"
                                CornerRadius="0,2,2,0" />
                        </Grid>
                        <TextBlock x:Name="ReadingModeText" Text="Reader" />
                    </StackPanel>
                </Button>

                <Rectangle x:Name="CommandBarCreationDivider" Width="1" Height="20" Fill="#24FFFFFF" />

                <Button
                    x:Name="ArrangeButton"
                    Click="ArrangeButton_Click"
                    Style="{StaticResource ToolbarPlainButtonStyle}"
                    ToolTipService.ToolTip="Arrange machines, folders, and threads into default zones">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Canvas Width="17" Height="15" VerticalAlignment="Center">
                            <Rectangle
                                x:Name="ArrangeTopLeftRect"
                                Canvas.Left="1"
                                Canvas.Top="1"
                                Width="7"
                                Height="6"
                                RadiusX="2"
                                RadiusY="2"
                                Fill="#00FFFFFF"
                                Stroke="#D7DCE5"
                                StrokeThickness="1" />
                            <Rectangle
                                x:Name="ArrangeBottomLeftRect"
                                Canvas.Left="1"
                                Canvas.Top="8"
                                Width="7"
                                Height="6"
                                RadiusX="2"
                                RadiusY="2"
                                Fill="#00FFFFFF"
                                Stroke="#D7DCE5"
                                StrokeThickness="1" />
                            <Rectangle
                                x:Name="ArrangeRightRect"
                                Canvas.Left="10"
                                Canvas.Top="2"
                                Width="6"
                                Height="12"
                                RadiusX="2"
                                RadiusY="2"
                                Fill="#00FFFFFF"
                                Stroke="#D7DCE5"
                                StrokeThickness="1" />
                        </Canvas>
                        <TextBlock Text="Arrange" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="SubagentsButton"
                    Click="SubagentsButton_Click"
                    Style="{StaticResource ToolbarPurpleButtonStyle}"
                    ToolTipService.ToolTip="Show or hide subagent nodes and lines">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Canvas
                            Width="17"
                            Height="15"
                            VerticalAlignment="Center">
                            <Path
                                x:Name="SubagentsRearPersonPath"
                                Data="M 4.8 6.3 C 3.5 6.3 2.6 5.3 2.6 4.1 C 2.6 2.9 3.5 1.9 4.8 1.9 C 6 1.9 6.9 2.9 6.9 4.1 C 6.9 5.3 6 6.3 4.8 6.3 Z M 1.1 12.9 C 1.5 9.5 3 7.7 5.1 7.7 C 6.2 7.7 7.1 8.2 7.8 9.3 C 6.5 10 5.6 11.2 5.2 12.9 Z"
                                Fill="#DDB8FF" />
                            <Path
                                x:Name="SubagentsFrontPersonPath"
                                Data="M 10.3 6.6 C 8.9 6.6 7.8 5.5 7.8 4 C 7.8 2.6 8.9 1.5 10.3 1.5 C 11.7 1.5 12.8 2.6 12.8 4 C 12.8 5.5 11.7 6.6 10.3 6.6 Z M 5.6 14 C 6 10.6 7.7 8.4 10.3 8.4 C 12.9 8.4 14.6 10.6 15 14 Z"
                                Fill="#DDB8FF" />
                            <Line
                                x:Name="SubagentsSlashLine"
                                X1="3.1"
                                Y1="13.2"
                                X2="14.2"
                                Y2="2"
                                Stroke="#D7DCE5"
                                StrokeThickness="1.8"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                Visibility="Collapsed" />
                        </Canvas>
                        <TextBlock Text="Subagents" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="SearchButton"
                    AutomationProperties.AutomationId="SearchButton"
                    AutomationProperties.Name="Search thread inbox"
                    Click="SearchButton_Click"
                    Style="{StaticResource ToolbarPlainButtonStyle}"
                    ToolTipService.ToolTip="Search the thread inbox">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Canvas
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center">
                            <Ellipse
                                x:Name="SearchLensEllipse"
                                Canvas.Left="1.8"
                                Canvas.Top="1.8"
                                Width="8.2"
                                Height="8.2"
                                Fill="#00FFFFFF"
                                Stroke="#D7DCE5"
                                StrokeThickness="1.55" />
                            <Line
                                x:Name="SearchHandleLine"
                                X1="8.7"
                                Y1="8.7"
                                X2="13"
                                Y2="13"
                                Stroke="#D7DCE5"
                                StrokeThickness="1.55"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                        </Canvas>
                        <TextBlock Text="Search" />
                    </StackPanel>
                </Button>

                <controls:SplitButton
                    x:Name="HealthButton"
                    Click="HealthButton_Click"
                    Style="{StaticResource ToolbarPlainSplitButtonStyle}"
                    AutomationProperties.AutomationId="HealthButton"
                    AutomationProperties.Name="Health"
                    ToolTipService.ToolTip="Refresh machine and runtime health">
                    <controls:SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Text="Refresh Now"
                                Click="RefreshHealthButton_Click">
                                <MenuFlyoutItem.Icon>
                                    <PathIcon
                                        Width="16"
                                        Height="16"
                                        Foreground="#D7DCE5"
                                        Data="M 12.7 4.9 C 11.8 2.9 9.8 1.7 7.5 1.7 C 4.3 1.7 1.8 4.2 1.8 7.4 C 1.8 10.6 4.3 13.1 7.5 13.1 C 9.4 13.1 11 12.2 12.1 10.8 L 10.6 9.5 C 9.8 10.6 8.8 11.1 7.5 11.1 C 5.4 11.1 3.8 9.5 3.8 7.4 C 3.8 5.3 5.4 3.7 7.5 3.7 C 9 3.7 10.2 4.4 10.9 5.7 L 8.8 5.7 L 12.2 9.1 L 15.4 5.7 L 12.7 5.7 Z" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Text="Run Diagnostics"
                                Click="RunDiagnosticsButton_Click">
                                <MenuFlyoutItem.Icon>
                                    <PathIcon
                                        Width="16"
                                        Height="16"
                                        Foreground="#D7DCE5"
                                        Data="M 3.1 1.5 L 4.6 1.5 L 4.6 5.8 C 4.6 7.1 5.6 8.1 6.9 8.1 C 8.2 8.1 9.2 7.1 9.2 5.8 L 9.2 1.5 L 10.7 1.5 L 10.7 5.8 C 10.7 7.6 9.5 9.1 7.8 9.5 L 7.8 10.6 C 7.8 12.2 8.9 13.3 10.4 13.3 C 11.5 13.3 12.3 12.7 12.7 11.8 C 12 11.5 11.5 10.8 11.5 10 C 11.5 8.9 12.4 8 13.5 8 C 14.6 8 15.5 8.9 15.5 10 C 15.5 10.9 15 11.7 14.2 12 C 13.8 13.8 12.3 15 10.4 15 C 8 15 6.2 13.2 6.2 10.6 L 6.2 9.5 C 4.4 9.2 3.1 7.6 3.1 5.8 Z M 1.1 1.4 L 2.7 1.4 L 2.7 3 L 1.1 3 Z M 11.1 1.4 L 12.7 1.4 L 12.7 3 L 11.1 3 Z M 13.5 9.2 C 13 9.2 12.7 9.6 12.7 10 C 12.7 10.5 13 10.8 13.5 10.8 C 13.9 10.8 14.3 10.5 14.3 10 C 14.3 9.6 13.9 9.2 13.5 9.2 Z" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Name="MachineRecoveryMenuItem"
                                Text="Show Machine Recovery"
                                Click="ToggleMachineRecoveryButton_Click">
                                <MenuFlyoutItem.Icon>
                                    <PathIcon
                                        Width="16"
                                        Height="16"
                                        Foreground="#D7DCE5"
                                        Data="M 5.7 1.5 L 10.3 1.5 L 10.3 3 L 14.2 3 L 14.2 13.8 L 1.8 13.8 L 1.8 3 L 5.7 3 Z M 7.1 2.5 L 7.1 3 L 8.9 3 L 8.9 2.5 Z M 3.2 4.4 L 3.2 12.4 L 12.8 12.4 L 12.8 4.4 Z M 7.3 6 L 8.7 6 L 8.7 7.4 L 10.1 7.4 L 10.1 8.8 L 8.7 8.8 L 8.7 10.2 L 7.3 10.2 L 7.3 8.8 L 5.9 8.8 L 5.9 7.4 L 7.3 7.4 Z" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Text="View Logs"
                                Click="ViewLogsButton_Click">
                                <MenuFlyoutItem.Icon>
                                    <PathIcon
                                        Width="16"
                                        Height="16"
                                        Foreground="#D7DCE5"
                                        Data="M 2.4 1.5 L 9.6 1.5 L 13.2 5.1 L 13.2 8.2 C 12.8 8.1 12.3 8 11.8 8 L 11.8 5.8 L 8.9 5.8 L 8.9 2.9 L 3.8 2.9 L 3.8 13.1 L 7.7 13.1 C 7.9 13.6 8.2 14.1 8.6 14.5 L 2.4 14.5 Z M 9.9 3.5 L 9.9 4.8 L 11.2 4.8 Z M 5.1 6.8 L 9.5 6.8 L 9.5 7.8 L 5.1 7.8 Z M 5.1 9.2 L 7.9 9.2 L 7.9 10.2 L 5.1 10.2 Z M 11.1 9.2 C 9.7 9.2 8.6 10.3 8.6 11.7 C 8.6 13.1 9.7 14.2 11.1 14.2 C 11.6 14.2 12.1 14 12.5 13.8 L 14.2 15.5 L 15.2 14.5 L 13.5 12.8 C 13.8 12.4 14 11.9 14 11.7 C 14 10.3 12.5 9.2 11.1 9.2 Z M 11.1 10.5 C 11.8 10.5 12.4 11 12.4 11.7 C 12.4 12.4 11.8 13 11.1 13 C 10.4 13 9.9 12.4 9.9 11.7 C 9.9 11 10.4 10.5 11.1 10.5 Z" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </controls:SplitButton.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Grid
                            x:Name="HealthIcon"
                            Width="16"
                            Height="14"
                            VerticalAlignment="Center">
                            <Canvas
                                x:Name="HealthRefreshIcon"
                                Width="16"
                                Height="14"
                                Visibility="Collapsed">
                                <Path
                                    x:Name="HealthRefreshArrowPath"
                                    Data="M 12.4 4.3 C 11.5 2.6 9.5 1.7 7.4 2 C 5.5 2.3 4 3.5 3.2 5.2 M 12.4 4.3 L 12.9 1.9 M 12.4 4.3 L 14.7 3.5 M 3.6 9.7 C 4.5 11.4 6.5 12.3 8.6 12 C 10.5 11.7 12 10.5 12.8 8.8 M 3.6 9.7 L 3.1 12.1 M 3.6 9.7 L 1.3 10.5"
                                    Fill="#00FFFFFF"
                                    Stroke="#D7DCE5"
                                    StrokeThickness="1.1"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round" />
                            </Canvas>
                            <Grid
                                x:Name="HealthHeartCardIcon"
                                Width="16"
                                Height="14">
                                <Border
                                    x:Name="HealthHeartSquareOutline"
                                    Width="15"
                                    Height="13"
                                    BorderBrush="#D7DCE5"
                                    BorderThickness="1"
                                    CornerRadius="2" />
                                <Path
                                    x:Name="HealthHeartPath"
                                    Data="M 5.2 7.5 C 4 6.5 3.2 5.7 3.2 4.7 C 3.2 3.8 3.8 3.2 4.6 3.2 C 5.1 3.2 5.5 3.5 5.8 3.9 C 6.1 3.5 6.5 3.2 7 3.2 C 7.8 3.2 8.4 3.8 8.4 4.7 C 8.4 5.7 7.6 6.5 6.4 7.5 L 5.8 8 Z"
                                    Fill="#D7DCE5"
                                    HorizontalAlignment="Left"
                                    Margin="2.6,1.8,0,0"
                                    VerticalAlignment="Top" />
                                <StackPanel
                                    Spacing="2"
                                    Width="6"
                                    HorizontalAlignment="Right"
                                    Margin="0,4,3,0"
                                    VerticalAlignment="Top">
                                    <Border x:Name="HealthTextLineTop" Height="1" Background="#D7DCE5" CornerRadius="0.5" />
                                    <Border x:Name="HealthTextLineBottom" Height="1" Background="#D7DCE5" CornerRadius="0.5" Opacity="0.75" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <TextBlock Text="Health" />
                    </StackPanel>
                </controls:SplitButton>

                <Button
                    x:Name="ActivityButton"
                    Click="ActivityButton_Click"
                    Style="{StaticResource ToolbarPlainButtonStyle}"
                    ToolTipService.ToolTip="Show recent notifications">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Grid
                            x:Name="ActivityIcon"
                            Width="16"
                            Height="15"
                            VerticalAlignment="Center">
                            <Path
