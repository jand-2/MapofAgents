                                                            <FontIcon Glyph="&#xEA80;" />
                                                        </ToggleMenuFlyoutItem.Icon>
                                                    </ToggleMenuFlyoutItem>
                                                    <ToggleMenuFlyoutItem
                                                        Tag="tools"
                                                        Text="{Binding ToolFilterMenuText}"
