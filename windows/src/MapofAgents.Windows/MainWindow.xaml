	                                                        Stroke="#FFFFFFFF"
	                                                        StrokeThickness="1.55"
	                                                        StrokeStartLineCap="Round"
	                                                        StrokeEndLineCap="Round" />
	                                                </Canvas>
	                                            </Viewbox>
	                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="{Binding RowContentSpacing}">
                                            <Grid ColumnSpacing="{Binding RowTitleTimeSpacing}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Text="{Binding Title}"
                                                    FontSize="{Binding RowTitleFontSize}"
                                                    FontWeight="SemiBold"
                                                    Foreground="#F2F4F7"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{Binding DisplayedAtLabel}"
                                                    FontSize="{Binding RowTimeFontSize}"
                                                    Foreground="#8F9BAA" />
                                            </Grid>
                                            <TextBlock
                                                Text="{Binding Message}"
                                                FontSize="{Binding RowMessageFontSize}"
                                                Foreground="{Binding MessageBrush}"
                                                TextWrapping="Wrap"
                                                MaxLines="2" />
                                            <TextBlock
                                                Text="{Binding Action}"
                                                FontSize="{Binding RowActionFontSize}"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding ForegroundBrush}"
                                                TextWrapping="Wrap"
                                                MaxLines="1" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border
                x:Name="StatusStripSurface"
                Margin="14"
                Padding="12,8"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{StaticResource MapRegularMaterialBrush}"
                BorderBrush="#00FFFFFF"
                BorderThickness="0"
                CornerRadius="8">
                <StackPanel
                    x:Name="StatusStripStack"
                    Orientation="Horizontal"
                    Spacing="12">
                    <StackPanel
                        x:Name="LocalStatusGroup"
                        Orientation="Horizontal"
                        Spacing="6">
                        <FontIcon
                            x:Name="StatusIcon"
                            Glyph="&#xEA3A;"
                            FontSize="12"
                            Foreground="#8F9BAA" />
                        <Canvas
                            x:Name="LocalStatusConnectedIcon"
                            Width="13"
                            Height="13"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Local runtime connected">
                            <Ellipse
                                x:Name="LocalStatusConnectedCircle"
                                Width="13"
                                Height="13"
                                Fill="#30D158" />
                            <Path
                                x:Name="LocalStatusConnectedCheckPath"
                                Data="M 3.7 6.8 L 5.7 8.8 L 9.6 4.7"
                                Fill="#00FFFFFF"
                                Stroke="#FFFFFFFF"
                                StrokeThickness="1.45"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round" />
                        </Canvas>
                        <TextBlock
                            x:Name="StatusText"
                            Text="Local: Disconnected"
                            FontSize="12"
                            Foreground="#A7B0BF" />
                    </StackPanel>

                    <Rectangle
                        x:Name="LocalStatusDivider"
                        Width="1"
                        Height="16"
                        Fill="#24FFFFFF" />

                    <StackPanel
                        x:Name="RemoteStatusGroup"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Canvas
                            x:Name="RemoteStatusAntennaIcon"
                            Width="16"
                            Height="14"
                            VerticalAlignment="Center"
                            Visibility="Visible"
                            AutomationProperties.Name="Remote status">
                            <Path
                                x:Name="RemoteStatusAntennaOuterLeftPath"
                                Data="M 4.7 9.6 C 2.8 7.8 2.8 4.6 4.7 2.8"
                                Fill="#00FFFFFF"
                                Stroke="#8F9BAA"
                                StrokeThickness="1.15"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                            <Path
                                x:Name="RemoteStatusAntennaOuterRightPath"
                                Data="M 11.3 2.8 C 13.2 4.6 13.2 7.8 11.3 9.6"
                                Fill="#00FFFFFF"
                                Stroke="#8F9BAA"
                                StrokeThickness="1.15"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                            <Path
                                x:Name="RemoteStatusAntennaInnerLeftPath"
                                Data="M 6.4 8 C 5.4 6.8 5.4 5.6 6.4 4.4"
                                Fill="#00FFFFFF"
                                Stroke="#8F9BAA"
                                StrokeThickness="1.15"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                            <Path
                                x:Name="RemoteStatusAntennaInnerRightPath"
                                Data="M 9.6 4.4 C 10.6 5.6 10.6 6.8 9.6 8"
                                Fill="#00FFFFFF"
                                Stroke="#8F9BAA"
                                StrokeThickness="1.15"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                            <Line
                                x:Name="RemoteStatusAntennaStemLine"
                                X1="8"
                                Y1="7.8"
                                X2="8"
                                Y2="12.3"
                                Stroke="#8F9BAA"
                                StrokeThickness="1.15"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                            <Ellipse
                                x:Name="RemoteStatusAntennaDot"
                                Canvas.Left="6.9"
                                Canvas.Top="6.5"
                                Width="2.2"
                                Height="2.2"
                                Fill="#8F9BAA" />
                        </Canvas>
                        <FontIcon
                            x:Name="RemoteStatusIcon"
                            Glyph="&#xE8CE;"
                            FontSize="12"
                            Foreground="#8F9BAA"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="RemoteStatusText"
                            Text="0 remotes connected"
                            FontSize="12"
                            Foreground="#A7B0BF" />
                    </StackPanel>

                    <Rectangle
                        x:Name="RemoteStatusDivider"
                        Width="1"
                        Height="16"
                        Fill="#24FFFFFF" />

                    <TextBlock
                        x:Name="NodeCountText"
                        Text="0 nodes"
                        FontSize="12"
                        Foreground="#A7B0BF" />

                    <TextBlock
                        x:Name="LineCountText"
                        Text="0 lines"
                        FontSize="12"
                        Foreground="#A7B0BF" />

                    <Rectangle
                        x:Name="StatusErrorDivider"
                        Width="1"
                        Height="16"
                        Fill="#24FFFFFF"
                        Visibility="Collapsed" />

                    <TextBlock
                        x:Name="StatusErrorText"
                        MaxWidth="420"
                        FontSize="12"
                        Foreground="#FF453A"
                        IsTextSelectionEnabled="True"
                        MaxLines="2"
                        TextWrapping="Wrap"
                        TextTrimming="CharacterEllipsis"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Canvas error" />
                </StackPanel>
            </Border>
    </Grid>
</Window>
