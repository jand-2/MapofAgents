                                                    <Canvas
                                                        Width="18"
                                                        Height="16"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                        <Path
                                                            Data="M 1.2 8.2 L 16.1 1.3 C 16.8 1 17.4 1.7 17 2.4 L 10.4 15 C 10 15.8 8.9 15.6 8.7 14.7 L 7.5 10.4 L 4 12.6 C 3.4 13 2.7 12.4 3 11.7 L 4.3 8.9 L 1.4 8.5 C 0.7 8.4 0.6 8.5 1.2 8.2 Z M 5.2 8.4 L 8.2 9.4 L 13 3.8 Z"
                                                            Fill="#FFFFFFFF" />
                                                    </Canvas>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            </Grid>

            <StackPanel
