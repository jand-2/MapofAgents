	                                                        Stroke="{Binding Foreground, ElementName=ReaderTranscriptFilterButton}"
	                                                        StrokeThickness="1.25" />
	                                                    <Line
	                                                        X1="4"
	                                                        Y1="5"
	                                                        X2="12"
