                                                AutomationProperties.Name="Failed">
                                                <Ellipse
                                                    Width="{Binding FilledStatusIconSize}"
                                                    Height="{Binding FilledStatusIconSize}"
                                                    Fill="{Binding StatusBrush}" />
                                                <Path
                                                    Data="M 4.6 4.6 L 8.4 8.4 M 8.4 4.6 L 4.6 8.4"
                                                    Fill="#00FFFFFF"
                                                    Stroke="#FFFFFFFF"
                                                    StrokeThickness="{Binding FilledStatusIconStrokeThickness}"
                                                    StrokeStartLineCap="Round"
                                                    StrokeEndLineCap="Round"
                                                    StrokeLineJoin="Round" />
                                            </Canvas>
                                            <Canvas
                                                Width="{Binding FilledStatusIconSize}"
                                                Height="{Binding FilledStatusIconSize}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding FilledWarningIconVisibility}"
                                                AutomationProperties.Name="Warning">
                                                <Path
                                                    Data="M 6.5 1.25 L 12.05 11.65 L 0.95 11.65 Z"
                                                    Fill="{Binding StatusBrush}"
                                                    Stroke="{Binding StatusBrush}"
                                                    StrokeThickness="0.6"
                                                    StrokeLineJoin="Round" />
                                                <Line
                                                    X1="6.5"
                                                    Y1="4.8"
                                                    X2="6.5"
                                                    Y2="7.7"
                                                    Stroke="#FFFFFFFF"
                                                    StrokeThickness="{Binding FilledStatusIconStrokeThickness}"
                                                    StrokeStartLineCap="Round"
                                                    StrokeEndLineCap="Round" />
                                                <Ellipse
                                                    Canvas.Left="5.85"
                                                    Canvas.Top="9.05"
                                                    Width="1.3"
                                                    Height="1.3"
                                                    Fill="#FFFFFFFF" />
                                            </Canvas>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="{Binding DetailStackSpacing}">
                                            <TextBlock
                                                Text="{Binding Title}"
                                                FontSize="{Binding TitleFontSize}"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{Binding Detail}"
                                                FontSize="{Binding DetailFontSize}"
                                                Foreground="{Binding DetailBrush}"
                                                TextWrapping="{Binding DetailTextWrapping}"
                                                TextTrimming="{Binding DetailTextTrimming}"
                                                MaxLines="{Binding DetailLineLimit}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border
                x:Name="ThreadInboxRail"
                Padding="12"
                Width="320"
                Background="{StaticResource MapRegularMaterialBrush}"
                BorderBrush="#24FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                Shadow="{StaticResource RailPanelShadow}"
                Translation="0,0,18">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Canvas Width="17" Height="15" VerticalAlignment="Center">
                                <Path
                                    x:Name="ThreadInboxHeaderTrayOutline"
                                    Data="M2,7 L4,3 C4.3,2.4 4.9,2 5.6,2 L11.4,2 C12.1,2 12.7,2.4 13,3 L15,7 L15,12 C15,13.1 14.1,14 13,14 L4,14 C2.9,14 2,13.1 2,12 Z M2,7 L6.2,7 C6.8,7 7.2,7.4 7.3,8 C7.4,9.1 8,9.7 8.5,9.7 C9,9.7 9.6,9.1 9.7,8 C9.8,7.4 10.2,7 10.8,7 L15,7"
                                    Fill="#00FFFFFF"
                                    Stroke="#A7B0BF"
                                    StrokeThickness="1.25"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round" />
                                <Line
                                    x:Name="ThreadInboxHeaderTrayTopLine"
                                    X1="5.2"
                                    Y1="4.2"
                                    X2="11.8"
                                    Y2="4.2"
                                    Stroke="#A7B0BF"
                                    StrokeThickness="1.25"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round" />
                                <Line
                                    x:Name="ThreadInboxHeaderTrayMiddleLine"
                                    X1="5"
                                    Y1="5.9"
                                    X2="12"
                                    Y2="5.9"
                                    Stroke="#A7B0BF"
                                    StrokeThickness="1.25"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round" />
                            </Canvas>
                            <TextBlock
                                x:Name="ThreadInboxHeaderTitleText"
                                Text="Thread Inbox"
                                FontSize="13"
                                FontWeight="SemiBold" />
                        </StackPanel>
                        <ProgressRing
                            x:Name="ThreadInboxRefreshProgress"
                            Grid.Column="1"
                            Width="18"
                            Height="18"
                            IsActive="False"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="RefreshInboxButton"
                            Grid.Column="2"
                            AutomationProperties.Name="Refresh thread inbox"
                            Click="RefreshInboxButton_Click"
                            ToolTipService.ToolTip="Refresh thread inbox"
                            Width="24"
                            Height="24"
	                            Padding="0"
	                            Background="#00FFFFFF"
	                            BorderBrush="#00FFFFFF"
	                            BorderThickness="0">
	                            <Canvas
	                                x:Name="ThreadInboxRefreshIcon"
	                                Width="15"
	                                Height="15"
	                                VerticalAlignment="Center">
	                                <Path
	                                    x:Name="ThreadInboxRefreshArrowPath"
	                                    Data="M 12.2 5.1 C 11.3 3.4 9.6 2.4 7.5 2.4 C 4.5 2.4 2.2 4.7 2.2 7.5 C 2.2 10.4 4.5 12.7 7.5 12.7 C 9.3 12.7 10.8 11.9 11.7 10.6 M 12.2 5.1 L 12.7 2.7 M 12.2 5.1 L 9.8 4.4"
	                                    Fill="#00FFFFFF"
	                                    Stroke="#A7B0BF"
	                                    StrokeThickness="1.3"
	                                    StrokeLineJoin="Round"
	                                    StrokeStartLineCap="Round"
	                                    StrokeEndLineCap="Round" />
	                            </Canvas>
	                        </Button>
                        <Button
                            x:Name="ThreadInboxCollapseButton"
                            Grid.Column="3"
                            AutomationProperties.Name="Minimize thread inbox"
                            Click="ThreadInboxCollapseButton_Click"
                            ToolTipService.ToolTip="Minimize"
                            Width="24"
                            Height="24"
	                            Padding="0"
	                            Background="#00FFFFFF"
	                            BorderBrush="#00FFFFFF"
	                            BorderThickness="0">
	                            <Canvas
	                                x:Name="ThreadInboxCollapseChevronIcon"
	                                Width="15"
	                                Height="15"
	                                VerticalAlignment="Center">
	                                <Path
	                                    x:Name="ThreadInboxCollapseChevronUpPath"
	                                    Data="M 3.5 9 L 7.5 5 L 11.5 9"
	                                    Fill="#00FFFFFF"
	                                    Stroke="#A7B0BF"
	                                    StrokeThickness="1.3"
	                                    StrokeLineJoin="Round"
	                                    StrokeStartLineCap="Round"
	                                    StrokeEndLineCap="Round" />
	                                <Path
	                                    x:Name="ThreadInboxCollapseChevronDownPath"
	                                    Data="M 3.5 6 L 7.5 10 L 11.5 6"
	                                    Fill="#00FFFFFF"
	                                    Stroke="#A7B0BF"
	                                    StrokeThickness="1.3"
	                                    StrokeLineJoin="Round"
	                                    StrokeStartLineCap="Round"
	                                    StrokeEndLineCap="Round"
	                                    Visibility="Collapsed" />
	                            </Canvas>
	                        </Button>
                    </Grid>

                    <StackPanel
                        x:Name="ThreadInboxContent"
                        Spacing="10">
                    <StackPanel Spacing="4">
                        <Grid
                            x:Name="ThreadInboxModePickerGrid"
                            ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="ThreadInboxActiveModeButton"
                                Click="ThreadInboxActiveModeButton_Click"
                                HorizontalAlignment="Stretch"
                                MinWidth="0"
                                MinHeight="24"
                                Padding="0,2">
                                <TextBlock
                                    Text="Active"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button
                                x:Name="ThreadInboxFinishedModeButton"
                                Grid.Column="1"
                                Click="ThreadInboxFinishedModeButton_Click"
                                HorizontalAlignment="Stretch"
                                MinWidth="0"
                                MinHeight="24"
                                Padding="0,2">
                                <TextBlock
                                    Text="Finished"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button
                                x:Name="ThreadInboxSecondaryModeButton"
                                Grid.Column="2"
                                Width="32"
                                MinWidth="0"
                                MinHeight="24"
                                Padding="0,2"
                                Visibility="Collapsed"
                                ToolTipService.ToolTip="More inbox views">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <ToggleMenuFlyoutItem
                                            x:Name="ThreadInboxNeedsModeMenuItem"
                                            Text="Needs You"
                                            Click="ThreadInboxNeedsModeButton_Click" />
                                        <ToggleMenuFlyoutItem
                                            x:Name="ThreadInboxUnreadModeMenuItem"
                                            Text="Unread"
                                            Click="ThreadInboxUnreadModeButton_Click" />
                                        <ToggleMenuFlyoutItem
                                            x:Name="ThreadInboxRecentModeMenuItem"
                                            Text="Recent"
                                            Click="ThreadInboxRecentModeButton_Click" />
                                        <MenuFlyoutSeparator />
                                        <ToggleMenuFlyoutItem
                                            x:Name="ThreadInboxArchivedModeMenuItem"
                                            Text="Archived"
                                            Click="ThreadInboxArchiveModeButton_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                                <Canvas
                                    x:Name="ThreadInboxSecondaryModeIcon"
                                    Width="15"
                                    Height="15"
                                    VerticalAlignment="Center">
                                    <Ellipse
                                        x:Name="ThreadInboxSecondaryModeDotLeft"
                                        Canvas.Left="2.3"
                                        Canvas.Top="6.4"
                                        Width="2.2"
                                        Height="2.2"
                                        Fill="#A7B0BF" />
                                    <Ellipse
                                        x:Name="ThreadInboxSecondaryModeDotMiddle"
                                        Canvas.Left="6.4"
                                        Canvas.Top="6.4"
                                        Width="2.2"
                                        Height="2.2"
                                        Fill="#A7B0BF" />
                                    <Ellipse
                                        x:Name="ThreadInboxSecondaryModeDotRight"
                                        Canvas.Left="10.5"
                                        Canvas.Top="6.4"
                                        Width="2.2"
                                        Height="2.2"
                                        Fill="#A7B0BF" />
                                </Canvas>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <ComboBox
                        x:Name="ThreadInboxWorkflowFilterBox"
                        SelectionChanged="ThreadInboxWorkflowFilterBox_SelectionChanged"
                        HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Grid Width="16" Height="14" VerticalAlignment="Center">
                                        <Canvas
                                            Width="16"
                                            Height="14"
                                            Visibility="{Binding TrayFullIconVisibility}">
                                            <Path
                                                Data="M1.5,6.4 L3.6,2.5 C3.9,1.9 4.4,1.6 5.1,1.6 L10.9,1.6 C11.6,1.6 12.1,1.9 12.4,2.5 L14.5,6.4 L14.5,11.2 C14.5,12.3 13.7,13.1 12.6,13.1 L3.4,13.1 C2.3,13.1 1.5,12.3 1.5,11.2 Z M1.5,6.4 L5.8,6.4 C6.4,6.4 6.8,6.8 6.9,7.4 C7,8.4 7.5,9 8,9 C8.5,9 9,8.4 9.1,7.4 C9.2,6.8 9.6,6.4 10.2,6.4 L14.5,6.4"
                                                Fill="#00FFFFFF"
                                                Stroke="{Binding GlyphBrush}"
                                                StrokeThickness="1.15"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeEndLineCap="Round" />
                                            <Line X1="5" Y1="3.7" X2="11" Y2="3.7" Stroke="{Binding GlyphBrush}" StrokeThickness="1.15" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <Line X1="4.8" Y1="5.2" X2="11.2" Y2="5.2" Stroke="{Binding GlyphBrush}" StrokeThickness="1.15" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Canvas>
                                        <Canvas
                                            Width="16"
                                            Height="14"
                                            Visibility="{Binding RectangleGroupIconVisibility}">
                                            <Rectangle Canvas.Left="1" Canvas.Top="1" Width="6.5" Height="5.5" RadiusX="1.7" RadiusY="1.7" Fill="#00FFFFFF" Stroke="{Binding GlyphBrush}" StrokeThickness="1.1" />
                                            <Rectangle Canvas.Left="1" Canvas.Top="7.5" Width="6.5" Height="5.5" RadiusX="1.7" RadiusY="1.7" Fill="#00FFFFFF" Stroke="{Binding GlyphBrush}" StrokeThickness="1.1" />
                                            <Rectangle Canvas.Left="9.5" Canvas.Top="2" Width="5.5" Height="11" RadiusX="1.7" RadiusY="1.7" Fill="#00FFFFFF" Stroke="{Binding GlyphBrush}" StrokeThickness="1.1" />
                                        </Canvas>
                                        <Canvas
                                            Width="16"
                                            Height="14"
                                            Visibility="{Binding DashedRectangleIconVisibility}">
                                            <Rectangle
                                                Canvas.Left="2"
                                                Canvas.Top="2"
                                                Width="12"
                                                Height="10"
                                                RadiusX="2"
                                                RadiusY="2"
                                                Fill="#00FFFFFF"
                                                Stroke="{Binding GlyphBrush}"
                                                StrokeThickness="1.1"
                                                StrokeDashArray="2,1.5" />
                                        </Canvas>
                                        <Canvas
                                            Width="16"
                                            Height="14"
                                            Visibility="{Binding RectangleStackIconVisibility}">
                                            <Rectangle Canvas.Left="4" Canvas.Top="1.5" Width="9" Height="7" RadiusX="1.7" RadiusY="1.7" Fill="#00FFFFFF" Stroke="{Binding GlyphBrush}" StrokeThickness="1.05" Opacity="0.7" />
                                            <Rectangle Canvas.Left="2" Canvas.Top="4.5" Width="9" Height="7" RadiusX="1.7" RadiusY="1.7" Fill="#00FFFFFF" Stroke="{Binding GlyphBrush}" StrokeThickness="1.05" />
                                        </Canvas>
                                        <Canvas
                                            Width="16"
                                            Height="14"
                                            Visibility="{Binding CheckmarkRectangleStackIconVisibility}">
                                            <Rectangle Canvas.Left="4" Canvas.Top="1.5" Width="9" Height="7" RadiusX="1.7" RadiusY="1.7" Fill="#00FFFFFF" Stroke="{Binding GlyphBrush}" StrokeThickness="1.05" Opacity="0.7" />
                                            <Rectangle Canvas.Left="2" Canvas.Top="4.5" Width="9" Height="7" RadiusX="1.7" RadiusY="1.7" Fill="#00FFFFFF" Stroke="{Binding GlyphBrush}" StrokeThickness="1.05" />
                                            <Path
                                                Data="M4,8.1 L6,10 L10,5.6"
                                                Stroke="{Binding GlyphBrush}"
                                                StrokeThickness="1.25"
                                                StrokeStartLineCap="Round"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Grid>
                                    <TextBlock
                                        Text="{Binding Title}"
                                        FontSize="12"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBox
                        x:Name="ThreadInboxSearchBox"
                        AutomationProperties.AutomationId="ThreadInboxSearchBox"
                        AutomationProperties.Name="Search threads"
                        PlaceholderText="Search threads"
                        TextChanged="ThreadInboxSearchBox_TextChanged"
                        Visibility="Collapsed" />

                    <Grid
                        x:Name="ThreadInboxWarningRow"
                        ColumnSpacing="6"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            x:Name="ThreadInboxWarningIcon"
                            Glyph="&#xE7BA;"
                            FontSize="11"
                            Foreground="#FF9F0A"
                            Width="14"
                            VerticalAlignment="Top" />
                        <TextBlock
                            x:Name="ThreadInboxWarningText"
                            Grid.Column="1"
                            FontSize="11"
                            Foreground="#FF9F0A"
                            TextWrapping="WrapWholeWords"
                            MaxLines="2" />
                    </Grid>

                    <StackPanel
                        x:Name="ThreadInboxAttentionSection"
                        Spacing="8"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="ThreadInboxAttentionSummaryText"
                            Text="0 requests"
                            FontSize="11"
                            Foreground="#8F9BAA" />
                        <ListView
                            x:Name="ThreadInboxAttentionList"
                            MaxHeight="360"
                            SelectionMode="None"
                            Background="#00FFFFFF"
                            BorderThickness="0"
                            IsItemClickEnabled="False"
                            Padding="0">
                            <ListView.ItemContainerStyle>
                                <Style
                                    TargetType="ListViewItem"
                                    BasedOn="{StaticResource RailListViewItemStyle}">
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
	                                <DataTemplate>
	                                    <Border
	                                        Padding="{Binding CardPadding}"
	                                        Background="{Binding CardBackgroundBrush}"
	                                        BorderBrush="{Binding CardBorderBrush}"
	                                        BorderThickness="{Binding CardBorderThickness}"
	                                        CornerRadius="{Binding CardCornerRadius}">
	                                        <StackPanel Spacing="{Binding CardSpacing}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock
                                                        Text="{Binding Method}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Text="{Binding TargetLabel}"
                                                        FontSize="11"
                                                        Foreground="#A7B0BF"
                                                        TextTrimming="CharacterEllipsis"
                                                        Visibility="{Binding TargetVisibility}" />
                                                </StackPanel>
	                                                <Button
	                                                    Grid.Column="1"
	                                                    Click="FocusAttentionRequestButton_Click"
	                                                    IsEnabled="{Binding HasOwningNode}"
	                                                    AutomationProperties.Name="Open owning thread"
	                                                    Width="{Binding FocusIconWidth}"
	                                                    Height="{Binding FocusIconHeight}"
	                                                    MinWidth="0"
	                                                    MinHeight="0"
	                                                    Padding="0"
	                                                    Background="#00FFFFFF"
	                                                    BorderThickness="0"
	                                                    ToolTipService.ToolTip="Open owning thread">
	                                                    <Canvas Width="{Binding FocusIconWidth}" Height="{Binding FocusIconHeight}">
	                                                        <Path
	                                                            Data="M 7.3 7.3 L 3.4 3.4 M 3.4 6.5 L 3.4 3.4 L 6.5 3.4"
	                                                            Fill="#00FFFFFF"
	                                                            Stroke="#A7B0BF"
	                                                            StrokeThickness="{Binding FocusIconStrokeThickness}"
	                                                            StrokeStartLineCap="Round"
	                                                            StrokeEndLineCap="Round"
	                                                            StrokeLineJoin="Round" />
                                                        <Path
	                                                            Data="M 10.7 10.7 L 14.6 14.6 M 14.6 11.5 L 14.6 14.6 L 11.5 14.6"
	                                                            Fill="#00FFFFFF"
	                                                            Stroke="#A7B0BF"
	                                                            StrokeThickness="{Binding FocusIconStrokeThickness}"
	                                                            StrokeStartLineCap="Round"
	                                                            StrokeEndLineCap="Round"
	                                                            StrokeLineJoin="Round" />
                                                    </Canvas>
                                                </Button>
                                            </Grid>

                                            <TextBlock
                                                Text="{Binding PromptText}"
                                                FontSize="11"
                                                Foreground="#C9D1DD"
                                                TextWrapping="Wrap"
                                                MaxLines="3" />

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="{Binding ActionButtonSpacing}"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding ApprovalVisibility}">
                                                <Button
                                                    Click="DenyAttentionRequestButton_Click"
                                                    Padding="{Binding ActionButtonPadding}">
                                                    <TextBlock
                                                        Text="Deny"
                                                        FontSize="11"
                                                        FontWeight="SemiBold" />
                                                </Button>
                                                <Button
                                                    Click="AllowAttentionRequestButton_Click"
                                                    Padding="{Binding ActionButtonPadding}"
                                                    Background="#B30A84FF"
                                                    BorderBrush="#660A84FF">
                                                    <TextBlock
                                                        Text="Allow"
                                                        FontSize="11"
                                                        FontWeight="SemiBold" />
                                                </Button>
                                            </StackPanel>

                                            <StackPanel
                                                Spacing="7"
                                                Visibility="{Binding TypedResponseVisibility}">
                                                <ComboBox
                                                    ItemsSource="{Binding ResponseChoices}"
                                                    SelectedItem="{Binding SelectedResponseChoice, Mode=TwoWay}"
                                                    DisplayMemberPath="Label"
                                                    PlaceholderText="Response"
                                                    HorizontalAlignment="Stretch"
                                                    FontSize="12"
                                                    Visibility="{Binding ChoiceResponseVisibility}" />
                                                <TextBox
                                                    Text="{Binding ResponseText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="Response"
                                                    FontSize="12"
                                                    Visibility="{Binding FreeformResponseVisibility}" />
                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="{Binding ActionButtonSpacing}"
                                                    HorizontalAlignment="Left">
                                                    <Button
                                                        Click="DeclineTypedAttentionRequestButton_Click"
                                                        Padding="{Binding ActionButtonPadding}">
                                                        <TextBlock
                                                            Text="Decline"
                                                            FontSize="11"
                                                            FontWeight="SemiBold" />
                                                    </Button>
                                                    <Button
                                                        Click="SendTypedAttentionRequestButton_Click"
                                                        IsEnabled="{Binding CanSendTypedResponse}"
                                                        Padding="{Binding ActionButtonPadding}"
                                                        Background="#B30A84FF"
                                                        BorderBrush="#660A84FF">
                                                        <TextBlock
                                                            Text="Send"
                                                            FontSize="11"
                                                            FontWeight="SemiBold" />
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <TextBlock
                        x:Name="ThreadInboxSummaryText"
                        Text="0 threads"
                        FontSize="11"
                        Foreground="#8F9BAA"
                        Visibility="Collapsed" />

                    <TextBlock
                        x:Name="ThreadInboxEmptyText"
                        FontSize="12"
                        Foreground="#A7B0BF"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <ListView
                        x:Name="ThreadInboxList"
                        ItemsSource="{x:Bind ThreadInboxItems}"
                        MaxHeight="360"
                        SelectionMode="None"
                        Background="#00FFFFFF"
                        BorderThickness="0"
                        IsItemClickEnabled="False"
                        Padding="0">
                        <ListView.ItemContainerStyle>
                            <Style
                                TargetType="ListViewItem"
                                BasedOn="{StaticResource RailListViewItemStyle}">
                                <Setter Property="Margin" Value="0,0,0,6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="{Binding RowPadding}"
                                    Background="#4D2A2C30"
                                    BorderThickness="0"
                                    CornerRadius="{Binding RowCornerRadius}"
                                    PointerEntered="ThreadInboxItem_PointerEntered"
                                    PointerExited="ThreadInboxItem_PointerExited">
                                    <StackPanel Spacing="{Binding RowSpacing}">
                                        <Button
                                            Click="OpenInboxThreadButton_Click"
                                            HorizontalAlignment="Stretch"
                                            Padding="0"
                                            Background="#00FFFFFF"
                                            BorderThickness="0">
                                            <Grid
                                                ColumnSpacing="{Binding TopRowIconTextSpacing}"
                                                HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid
                                                    Width="18"
                                                    Height="18"
                                                    Margin="0,1,0,0"
                                                    VerticalAlignment="Top">
                                                    <FontIcon
                                                        Glyph="{Binding LeadingGlyph}"
                                                        FontSize="14"
                                                        Foreground="{Binding LeadingBrush}"
                                                        Width="18"
                                                        Visibility="{Binding LeadingGlyphVisibility}" />
                                                    <Canvas
                                                        Width="{Binding LeadingThreadPairIconWidth}"
                                                        Height="{Binding LeadingThreadPairIconHeight}"
