	                                                                            <ColumnDefinition Width="{Binding IconColumnWidth}" />
	                                                                            <ColumnDefinition Width="*" />
	                                                                        </Grid.ColumnDefinitions>
	                                                                        <FontIcon
	                                                                            Glyph="{Binding Glyph}"
	                                                                            FontSize="{Binding IconFontSize}"
	                                                                            Foreground="{Binding ForegroundBrush}" />
