	                                                            <Border
	                                                                Margin="{Binding TrayChipMargin}"
	                                                                Padding="{Binding ChipPadding}"
	                                                                Background="{Binding ChipBackgroundBrush}"
	                                                                BorderBrush="{Binding ChipBorderBrush}"
	                                                                BorderThickness="1"
	                                                                CornerRadius="8">
	                                                                <StackPanel Orientation="Horizontal" Spacing="{Binding ContentSpacing}">
