{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapofagents.dev/schema/workflow-event.schema.json",
  "title": "MapofAgents workflow event",
  "description": "Canonical, privacy-bounded event envelope emitted by the MapofAgents workflow hook producer.",
  "oneOf": [
    { "$ref": "#/$defs/turnStarted" },
    { "$ref": "#/$defs/turnCompleted" },
    { "$ref": "#/$defs/threadCreated" },
    { "$ref": "#/$defs/folderCreated" },
    { "$ref": "#/$defs/needsInput" },
    { "$ref": "#/$defs/failed" }
  ],
  "$defs": {
    "baseEvent": {
      "type": "object",
      "required": ["id", "source", "type", "method", "summary", "createdAt"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Producer event id. Consumers may prefix or wrap it for local storage."
        },
        "source": { "const": "codex-hook" },
        "type": { "type": "string" },
        "method": { "type": "string", "minLength": 1 },
        "sourceHostID": { "type": "string" },
        "sourceThreadID": { "type": "string" },
        "sourceTurnID": { "type": "string" },
        "hostID": { "type": "string" },
        "threadID": { "type": "string" },
        "turnID": { "type": "string" },
        "summary": { "type": "string" },
        "createdAt": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            {
              "type": "number",
              "description": "Unix epoch seconds, or milliseconds when greater than 10000000000."
            }
          ]
        },
        "raw": {
          "description": "Opt-in, redacted, size-bounded source payload. Absent by default."
        },
        "rawTruncated": { "type": "boolean" }
      }
    },
    "turnStarted": {
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "turn.started" },
            "method": { "const": "turn/started" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "turnCompleted": {
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "turn.completed" },
            "method": { "const": "turn/completed" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "threadCreated": {
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "thread.created" },
            "method": { "const": "thread/created" },
            "childHostID": { "type": "string" },
            "childThreadID": { "type": "string" },
            "cwd": { "type": "string" },
            "title": { "type": "string" },
            "kind": {
              "enum": ["thread", "subagent"]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "folderCreated": {
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "folder.created" },
            "method": { "const": "folder/created" },
            "childHostID": { "type": "string" },
            "folderPath": { "type": "string" },
            "title": { "type": "string" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "needsInput": {
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "needs.input" },
            "method": { "const": "hook/needsInput" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "failed": {
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "failed" },
            "method": { "const": "hook/failed" }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
