{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapofagents.dev/schema/app-server.schema.json",
  "title": "MapofAgents App Server protocol envelope",
  "description": "Disjoint endpoint and JSON-RPC-style message shapes used by MapofAgents. The Codex App Server transport omits the optional jsonrpc member.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/relayEndpoint"
    },
    {
      "$ref": "#/$defs/jsonRpcRequest"
    },
    {
      "$ref": "#/$defs/jsonRpcNotification"
    },
    {
      "$ref": "#/$defs/jsonRpcSuccessResponse"
    },
    {
      "$ref": "#/$defs/jsonRpcErrorResponse"
    }
  ],
  "$defs": {
    "requestID": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "relayEndpoint": {
      "type": "object",
      "required": [
        "id",
        "name",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^wss?://\\S+$"
        },
        "bearerToken": {
          "type": "string",
          "minLength": 1,
          "description": "Runtime-only secret; persisted endpoint descriptors should redact or omit this value."
        },
        "credentialReference": {
          "type": "string",
          "minLength": 1,
          "description": "Stable local Keychain reference used by persisted endpoint descriptors; never a credential value."
        }
      },
      "additionalProperties": false
    },
    "jsonValue": true,
    "jsonRpcRequest": {
      "type": "object",
      "required": [
        "id",
        "method"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/requestID"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "$ref": "#/$defs/jsonValue"
        }
      },
      "additionalProperties": false
    },
    "jsonRpcNotification": {
      "type": "object",
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "$ref": "#/$defs/jsonValue"
        }
      },
      "additionalProperties": false
    },
    "jsonRpcSuccessResponse": {
      "type": "object",
      "required": [
        "id",
        "result"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/requestID"
        },
        "result": {
          "$ref": "#/$defs/jsonValue"
        }
      },
      "additionalProperties": false
    },
    "jsonRpcErrorResponse": {
      "type": "object",
      "required": [
        "id",
        "error"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/requestID"
        },
        "error": {
          "$ref": "#/$defs/jsonValue"
        }
      },
      "additionalProperties": false
    }
  }
}
